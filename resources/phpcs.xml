<?xml version="1.0"?>
<ruleset name="Vokuro ADR">
    <description>Vökuró ADR Coding Standards</description>

    <!-- Arguments:
         p = Show progress
         s = Show sniff codes in output
         colors = Force color output (optional, often auto-detected)
    -->
    <arg name="colors"/>
    <arg value="ps"/>

    <rule ref="Phalcon">
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>
    </rule>

    <file>../src</file>
    <file>../public/index.php</file>
    <file>migrations</file>
    <file>seeds</file>
</ruleset>
